# Supabase Edge secrets only. Never expose these private values in frontend.
VAPID_PUBLIC_KEY=YOUR_EXISTING_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_EXISTING_PRIVATE_KEY
VAPID_SUBJECT=mailto:YOUR_ADMIN_EMAIL
MYB_CRON_SECRET=GENERATE_A_RANDOM_64_CHARACTER_HEX_SECRET
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by hosted Edge runtime.

# V17.18.0: Supabase Edge secrets only, no family login.
GOOGLE_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=YOUR_OWNER_REFRESH_TOKEN
GOOGLE_DRIVE_FOLDER_ID=YOUR_FIXED_FOLDER_ID
MEMORY_ALLOWED_ORIGINS=https://YOUR_APP_DOMAIN,http://127.0.0.1:8080
MEMORY_DAILY_WRITES=200
